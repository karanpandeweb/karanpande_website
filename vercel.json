{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend run build",
  "installCommand": "uv sync --frozen --no-dev && npm --prefix frontend ci --legacy-peer-deps",
  "outputDirectory": "frontend/build",
  "rewrites": [
    {
      "source": "/wedding/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/pre-wedding/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/cinematic/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**",
      "excludeFiles": "{frontend/node_modules/**,frontend/build/**,frontend/public/**,test_reports/**}",
      "maxDuration": 30
    }
  }
}
